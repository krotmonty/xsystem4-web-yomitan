+/*
+ * Lays out text exactly as gfx_render_textf() would, without drawing it.
+ * Calls `cb` with the x offset and advance of each character.
+ */
+float gfx_layout_text(struct text_style *ts, const char *msg, gfx_text_layout_cb cb, void *data)
+{
+	enum font_weight weight = gfx_int_to_font_weight(ts->weight);
+	struct font_size *font_size = text_style_font_size(ts);
+	float edge_spacing = gfx_text_advance_edges
+		? text_style_edge_width(ts) + ceilf(ts->bold_width)
+		: 0.f;
+
+	float pos_x = 0.f;
+	while (*msg) {
+		pos_x += edge_spacing;
+		float scale_x = *msg == ' ' ? ts->space_scale_x : ts->scale_x;
+		uint32_t code = char_to_code(msg, font_size->font->charmap);
+		const char *ch = msg;
+		int len = SJIS_2BYTE(*msg) ? 2 : 1;
+		msg += len;
+		struct glyph *glyph = font_get_glyph(font_size, code, weight);
+		if (!glyph)
+			continue;
+		float x = pos_x;
+		pos_x += glyph->advance * scale_x * config.text_x_scale + ts->font_spacing;
+		if (cb)
+			cb(data, ch, len, x, pos_x - x);
+		pos_x += edge_spacing;
+	}
+	return pos_x;
+}
+
